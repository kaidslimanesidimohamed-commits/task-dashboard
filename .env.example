# انسخ هذا الملف إلى .env وأضف القيم الحقيقية
# Copy this file to .env and fill in real values

# محتوى credentials.json كاملاً في سطر واحد (JSON مضغوط)
# Full contents of credentials.json as a single-line JSON string
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# معرّف Google Spreadsheet من الرابط
# Google Spreadsheet ID from the URL
SPREADSHEET_ID=1opb9YsEQEOf-FaMdmX-v1bXV63i8Qnt17XIp7dUmce8

# المنفذ (Railway يضبطه تلقائياً)
# Port (Railway sets this automatically)
PORT=3000
